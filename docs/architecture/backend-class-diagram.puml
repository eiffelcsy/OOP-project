package "repository" {
  interface AppointmentRepository <<interface>> {
    +findByDoctorId(doctorId: Long): List<Appointment>
    +findByClinicId(clinicId: Long): List<Appointment>
    +findByStatus(status: String): List<Appointment>
    +findByPatientId(patientId: Long): List<Appointment>
    +findByStatusAndStartTimeBetween(status: String, start: OffsetDateTime, end: OffsetDateTime): List<Appointment>
    +countOverlapping(doctorId: Long, startTime: OffsetDateTime, endTime: OffsetDateTime): long
  }
  interface QueueTicketRepository <<interface>> {
    +findByQueue(queue: Queue): List<QueueTicket>
    +findByQueueId(queueId: Long): List<QueueTicket>
    +findByQueueIdWithPatient(queueId: Long): List<QueueTicket>
    +findByPatientId(patientId: Long): List<QueueTicket>
    +findByQueueAndStatus(queue: Queue, status: String): List<QueueTicket>
  }
  interface QueueRepository <<interface>> {
    +findByClinicId(clinicId: Long): List<Queue>
    +findByQueueStatus(status: QueueStatus): List<Queue>
    +findActiveQueuesByClinicId(clinicId: Long): List<Queue>
    +countByClinicId(clinicId: Long): long
    +countByQueueStatus(status: QueueStatus): long
  }
  interface PatientRepository <<interface>> {
    +findByIdIn(ids: List<Long>): List<Patient>
    +findByUserId(userId: String): Optional<Patient>
    +findByNric(nric: String): Optional<Patient>
    +findByPhone(phone: String): Optional<Patient>
    +findByDob(dob: LocalDate): List<Patient>
    +searchByPhone(phone: String): List<Patient>
    +searchByAddress(address: String): List<Patient>
    +existsByUserId(userId: String): boolean
    +existsByNric(nric: String): boolean
    +countAllPatients(): long
    +deleteByUserId(userId: String): void
  }
  interface DoctorRepository <<interface>> {
    +findByClinicId(clinicId: Long): List<Doctor>
  }
  interface StaffRepository <<interface>> {
    +findByUserId(userId: String): Optional<Staff>
    +findByClinic(clinic: Clinic): List<Staff>
    +findByClinicId(clinicId: Long): List<Staff>
    +findByRole(role: String): List<Staff>
    +findByClinicAndRole(clinic: Clinic, role: String): List<Staff>
    +findByClinicIdAndRole(clinicId: Long, role: String): List<Staff>
    +existsByUserId(userId: String): boolean
    +countByClinicId(clinicId: Long): long
    +countByRole(role: String): long
    +deleteByUserId(userId: String): void
  }
  interface ProfileRepository <<interface>> {
    +findByUserId(userId: String): Optional<Profile>
    +findByEmail(email: String): Optional<Profile>
    +existsByUserId(userId: String): boolean
    +existsByEmail(email: String): boolean
    +deleteByUserId(userId: String): void
    +findByUserIdIn(userIds: List<String>): List<Profile>
  }
  interface ClinicRepository <<interface>> {
    +findByName(name: String): Optional<Clinic>
    +findByRegion(region: String): List<Clinic>
    +findByArea(area: String): List<Clinic>
    +findByRegionAndArea(region: String, area: String): List<Clinic>
    +findByClinicType(clinicType: String): List<Clinic>
    +searchByName(name: String): List<Clinic>
    +findByRegionOrderByNameAsc(region: String): List<Clinic>
    +existsByName(name: String): boolean
  }
  interface ScheduleRepository <<interface>> {
    +findByDoctorId(doctorId: Long): List<Schedule>
    +findByDoctorIdAndDayOfWeek(doctorId: Long, dayOfWeek: Integer): List<Schedule>
    +findByDayOfWeek(dayOfWeek: Integer): List<Schedule>
    +findValidSchedulesForDate(doctorId: Long, date: LocalDate, dayOfWeek: Integer): List<Schedule>
    +findValidSchedulesForDate(doctorId: Long, date: LocalDate): List<Schedule>
    +findSchedulesInDateRange(doctorId: Long, startDate: LocalDate, endDate: LocalDate): List<Schedule>
    +findActiveSchedules(today: LocalDate): List<Schedule>
    +existsByDoctorIdAndDayOfWeek(doctorId: Long, dayOfWeek: Integer): boolean
    +deleteByDoctorId(doctorId: Long): void
  }
  interface AdminRepository <<interface>> {
    +findByUserId(userId: String): Optional<Admin>
    +existsByUserId(userId: String): boolean
    +countAllAdmins(): long
    +deleteByUserId(userId: String): void
  }
}

package "service" {
  class AppointmentService {
    +getAppointments(doctorId: Long, clinicId: Long, status: String): List<Appointment>
