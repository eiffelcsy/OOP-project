@startuml AppointmentCreation
skinparam style strict
skinparam shadowing false
hide footbox
autonumber

actor "patient : User" as Patient
participant "Appointments Page" as FE
participant "api : PatientController" as API
participant "service : AppointmentService" as APS
participant "repo : AppointmentRepository" as AR <<interface>>
database "db : appointments" as DB
participant "appt : Appointment" as APPT

Patient -> FE: Open page and fill form
activate Patient
activate FE
FE -> API: createAppointment(request): ResponseEntity
activate API
API -> APS: addAppointment(appointment): Appointment
activate APS
APS -> APPT: <<create>> Appointment(request): Appointment
activate APPT
APPT --> APS: Appointment
deactivate APPT
APS -> AR: countOverlapping(doctorId, start, end): long
activate AR
AR --> APS: long
deactivate AR

alt Slot available
  APS -> AR: save(appt): Appointment
  activate AR
  AR -> DB: INSERT appointments
  activate DB
  DB --> AR: Appointment(id)
  deactivate DB
  AR --> APS: Appointment
  deactivate AR
  APS --> API: Appointment
  API --> FE: 201 Created + Appointment
  FE -> Patient: Show confirmation
else Slot not available
  APS --> API: ValidationError
  deactivate APS
  API --> FE: 409 Conflict
  deactivate API
  FE -> Patient: Show error
  deactivate FE
  deactivate Patient
end
@enduml